---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import DayTimeline from './DayTimeline.astro';
import ChildView from './ChildView.astro';
import Tricks from './Tricks.astro';
import DataSection from './DataSection.astro';
import Install from './Install.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <a class="skip-link" href="#top">
    {locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}
  </a>
  <Header locale={locale} />
  <main id="top">
    <Hero locale={locale} />
    <DayTimeline locale={locale} />
    <ChildView locale={locale} />
    <Tricks locale={locale} />
    <DataSection locale={locale} />
    <Install locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
