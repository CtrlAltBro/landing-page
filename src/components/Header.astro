---
import Logo from './Logo.astro';
import Key from './Key.astro';
import ThemeToggle from './ThemeToggle.astro';
import { homePath, locales, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header class="site-header">
  <nav class="bar wrap">
    <a href="#top" class="home" aria-label={t.nav.home}>
      <Logo size="sm" pressable />
    </a>
    <div class="spacer"></div>
    <ul class="links">
      {t.nav.links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
      <li>
        <a href={locale === 'en' ? '/en/docs/' : '/docs/'}>Documentation</a>
      </li>
    </ul>
    <ul class="langs" aria-label={t.nav.langAria}>
      {locales.map((l) => (
        <li>
          {l === locale ? (
            <Key tone="violet" size="xs" aria-current="true" lang={l}>
              {l.toUpperCase()}
            </Key>
          ) : (
            <Key tone="cream" size="xs" pressable href={homePath(l)} hreflang={l} lang={l}>
              {l.toUpperCase()}
            </Key>
          )}
        </li>
      ))}
    </ul>
    <span class="theme-toggle"><ThemeToggle locale={locale} /></span>
    <Key
      as="button"
      tone="violet"
      size="sm"
      square
      pressable
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="landing-menu"
      aria-label={locale === 'fr' ? 'Ouvrir le menu' : 'Open menu'}
      data-menu-toggle
      data-open-label={locale === 'fr' ? 'Ouvrir le menu' : 'Open menu'}
      data-close-label={locale === 'fr' ? 'Fermer le menu' : 'Close menu'}
    >
      <span class="burger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </Key>
  </nav>
  <div id="landing-menu" class="mobile-menu" hidden>
    <nav
      class="wrap mobile-inner"
      aria-label={locale === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}
    >
      <span class="menu-caption">{locale === 'fr' ? 'À vous les commandes' : 'Take control'}</span>
      {t.nav.links.map((link, i) => (
        <a href={link.href}>
          <span class="menu-number">0{i + 1}</span>
          <span>{link.label}</span>
          <span class="menu-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
      <a href={locale === 'en' ? '/en/docs/' : '/docs/'}>
        <span class="menu-number">05</span>
        <span>Documentation</span>
        <span class="menu-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <span class="menu-theme"><ThemeToggle locale={locale} /></span>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('#landing-menu');
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? 'Menu',
      );
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
    matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background-color 600ms var(--ease-out);
  }
  .bar {
    padding-top: 12px;
    padding-bottom: 12px;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .home {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
  }
  .home:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }
  .spacer {
    flex: 1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--fs-small);
    font-weight: 600;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .links a {
    color: var(--text);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--text-violet);
  }
  .langs {
    display: flex;
    gap: 6px;
  }
  .langs :global(.cab-key) {
    --fs: 12px;
    --px: 8px;
  }
  .theme-toggle {
    text-decoration: none;
    white-space: nowrap;
  }
  :global(.menu-toggle) {
    display: none;
  }
  .burger {
    width: 18px;
    display: grid;
    gap: 4px;
  }
  .burger span {
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }
  :global(.menu-toggle[aria-expanded='true']) .burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  :global(.menu-toggle[aria-expanded='true']) .burger span:nth-child(2) {
    opacity: 0;
  }
  :global(.menu-toggle[aria-expanded='true']) .burger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    max-height: calc(100dvh - 80px);
    overflow-y: auto;
    box-shadow: 0 20px 32px rgba(28, 24, 48, 0.12);
  }
  .mobile-inner {
    padding-block: 20px 28px;
    display: grid;
    animation: menu-enter 180ms ease-out;
  }
  .menu-caption {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .mobile-inner a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    font: 700 24px var(--font-display);
  }
  .mobile-inner a:hover {
    color: var(--text-violet);
  }
  .menu-number {
    font: 12px var(--font-mono);
    color: var(--text-muted);
  }
  .menu-arrow {
    margin-left: auto;
    color: var(--text-violet);
  }
  .menu-theme {
    justify-self: start;
    margin-top: 20px;
  }
  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-inner {
      animation: none;
    }
    .burger span {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .links {
      display: none;
    }
    :global(.menu-toggle) {
      display: inline-flex;
      --h: 40px;
      --px: 12px;
      --r: 8px;
    }
    .bar {
      gap: 12px;
    }
    .theme-toggle {
      font-size: 12px;
    }
  }
  @media (max-width: 420px) {
    .bar {
      gap: 8px;
    }
    .theme-toggle {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .theme-toggle {
      font-size: 12px;
    }
  }
</style>
