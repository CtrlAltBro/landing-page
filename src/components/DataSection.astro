---
import { links, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).data;
---

<section id="donnees" aria-labelledby="donnees-title" class="data wrap">
  <div class="grid">
    <div class="copy" data-reveal>
      <h2 id="donnees-title" class="t-h2 title">
        {t.title}
      </h2>
      <p class="lead">{t.lead}</p>
      <a href={links.repo} class="cab-ghost link" rel="noopener">
        {t.link}
      </a>
    </div>
    <dl class="faq" data-reveal style="--reveal-delay:100ms">
      {t.faq.map((f) => (
        <div class="faq-row">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .data {
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--space-7) var(--space-8);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .title {
    margin: 0;
    max-width: 12ch;
  }
  .lead {
    margin: 0;
    color: var(--text-muted);
    max-width: 40ch;
  }
  .link {
    align-self: flex-start;
  }
  .faq {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .faq-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-strong);
  }
  .faq-row:last-child {
    border-bottom: 1px solid var(--border-strong);
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
</style>
