---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Key from './Key.astro';
import { links, useScreens, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const screens = useScreens(locale);
---

<section aria-labelledby="hero-title" class="hero wrap">
  <div class="hero-logo" role="img" aria-label="CtrlAltBro">
    <Logo size="hero" intro />
  </div>
  <div class="hero-grid">
    <h1 id="hero-title" class="t-h1 hero-title">
      {t.hero.title}
    </h1>
    <div class="hero-side">
      <p class="t-body-l lead">{t.hero.lead}</p>
      <div class="actions">
        <Key tone="violet" size="lg" pressable href="#installer">
          {t.hero.cta}
        </Key>
        <a href={links.repo} class="cab-ghost" rel="noopener">
          {t.hero.github}
        </a>
      </div>
    </div>
  </div>
  <figure class="window">
    <div class="window-bar" aria-hidden="true">
      <span class="window-title">{t.hero.windowTitle}</span>
      <span>—</span>
      <span>▢</span>
      <span>✕</span>
    </div>
    <Image
      src={screens.dashboard}
      alt={t.hero.screenshotAlt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="(max-width: 1248px) calc(100vw - 2 * clamp(20px, 4vw, 48px)), 1104px"
      loading="eager"
      fetchpriority="high"
      class="window-img"
    />
  </figure>
</section>

<style>
  .hero {
    padding-top: var(--space-9);
    padding-bottom: var(--space-8);
  }
  .hero-logo {
    display: inline-flex;
    margin-bottom: var(--space-7);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--space-7) var(--space-8);
    align-items: end;
  }
  .hero-title {
    margin: 0;
    font-weight: 800;
    max-width: 13ch;
  }
  .hero-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 46ch;
  }
  .lead {
    margin: 0;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .window {
    margin: var(--space-8) 0 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-pop);
  }
  .window-bar {
    display: flex;
    align-items: center;
    height: 34px;
    padding-left: 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .window-bar span:not(.window-title) {
    width: 42px;
    text-align: center;
    font-size: 11px;
  }
  .window-title {
    flex: 1;
  }
  .window-img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--night-900);
  }
  @media (max-width: 520px) {
    .hero {
      padding-top: var(--space-8);
    }
  }
</style>
